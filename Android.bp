soong_namespace {}

cc_prebuilt_library_shared {
    name: "libmtkisp_metadata_sys",
    srcs: ["proprietary/system_ext/lib64/libmtkisp_metadata_sys.so"],
    shared_libs: ["libui", "liblog", "libutils"],
    compile_multilib: "64", strip: { none: true }, check_elf_files: false,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.mediatek.hardware.camera.isphal-V1-ndk-system_ext",
    stem: "vendor.mediatek.hardware.camera.isphal-V1-ndk",
    srcs: ["proprietary/system_ext/lib64/vendor.mediatek.hardware.camera.isphal-V1-ndk.so"],
    compile_multilib: "64", strip: { none: true }, check_elf_files: false,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.mediatek.hardware.camera.isphal@1.0-system_ext",
    stem: "vendor.mediatek.hardware.camera.isphal@1.0",
    srcs: ["proprietary/system_ext/lib64/vendor.mediatek.hardware.camera.isphal@1.0.so"],
    compile_multilib: "64", strip: { none: true }, check_elf_files: false,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi",
    srcs: ["proprietary/system_ext/lib64/libcamera_algoup_jni.xiaomi.so"],
    compile_multilib: "64", strip: { none: true }, check_elf_files: false,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libcamera_ispinterface_jni.xiaomi",
    srcs: ["proprietary/system_ext/lib64/libcamera_ispinterface_jni.xiaomi.so"],
    required: [
        "libmtkisp_metadata_sys",
        "vendor.mediatek.hardware.camera.isphal-V1-ndk-system_ext",
        "vendor.mediatek.hardware.camera.isphal@1.0-system_ext",
    ],
    compile_multilib: "64", strip: { none: true }, check_elf_files: false,
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libcamera_mianode_jni.xiaomi",
    srcs: ["proprietary/system_ext/lib64/libcamera_mianode_jni.xiaomi.so"],
    compile_multilib: "64", strip: { none: true }, check_elf_files: false,
    system_ext_specific: true,
}

android_app_import {
    name: "MiuiCamera",
    apk: "proprietary/system_ext/priv-app/MiuiCamera/MiuiCamera.apk",
    certificate: "platform",
    privileged: true,
    dex_preopt: { enabled: false },
    overrides: ["Aperture"],
    system_ext_specific: true,
}

// MiSys (vendor AIDL HALs used by MiuiCamera to write calibration data to persist)
cc_prebuilt_library_shared {
    name: "vendor.xiaomi.hardware.misys.common-V1-ndk",
    owner: "xiaomi",
    srcs: ["proprietary/vendor/lib64/vendor.xiaomi.hardware.misys.common-V1-ndk.so"],
    compile_multilib: "64",
    strip: { none: true },
    check_elf_files: false,
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "vendor.xiaomi.hardware.misys.core-V1-ndk",
    owner: "xiaomi",
    srcs: ["proprietary/vendor/lib64/vendor.xiaomi.hardware.misys.core-V1-ndk.so"],
    compile_multilib: "64",
    strip: { none: true },
    check_elf_files: false,
    vendor: true,
}

cc_prebuilt_binary {
    name: "vendor.xiaomi.hardware.misys.common.service",
    owner: "xiaomi",
    srcs: ["proprietary/vendor/bin/hw/vendor.xiaomi.hardware.misys.common.service"],
    relative_install_path: "hw",
    init_rc: ["configs/misys/vendor.xiaomi.hardware.misys.common-service.rc"],
    vintf_fragments: ["configs/misys/vendor.xiaomi.hardware.misys.common.xml"],
    required: [
        "vendor.xiaomi.hardware.misys.common-V1-ndk",
        "vendor.xiaomi.hardware.misys.core-V1-ndk",
    ],
    compile_multilib: "first",
    strip: { none: true },
    check_elf_files: false,
    vendor: true,
}

cc_prebuilt_binary {
    name: "vendor.xiaomi.hardware.misys.core.service",
    owner: "xiaomi",
    srcs: ["proprietary/vendor/bin/hw/vendor.xiaomi.hardware.misys.core.service"],
    relative_install_path: "hw",
    init_rc: ["configs/misys/vendor.xiaomi.hardware.misys.core-service.rc"],
    vintf_fragments: ["configs/misys/vendor.xiaomi.hardware.misys.core.xml"],
    required: ["vendor.xiaomi.hardware.misys.core-V1-ndk"],
